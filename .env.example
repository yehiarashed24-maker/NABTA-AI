# Gemini API Key for server-side RAG, embeddings, study guide, quiz generation, and viva oral exam
GEMINI_API_KEY=
GEMINI_CHAT_MODEL=gemini-3.5-flash
GEMINI_MODEL=gemini-3.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_LIVE_MODEL=gemini-2.0-flash-exp

# Neon Serverless PostgreSQL Database connection string (optional for cloud persistence on Vercel/Render)
DATABASE_URL=

# Google OAuth Web Client ID from Google Cloud Console → APIs & Services → Credentials.
# Add http://localhost:5173 and http://127.0.0.1:5173 as Authorized JavaScript origins.
GOOGLE_CLIENT_ID=
# Generate a long random value for production (for example: openssl rand -hex 32).
SESSION_SECRET=
PORT=5173
MAX_FILE_MB=12
CHUNK_SIZE=1100
CHUNK_OVERLAP=180
RETRIEVAL_TOP_K=5
DATA_PATH=./data/store.json
UPLOAD_PATH=./uploads
